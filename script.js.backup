// Random dialogue system
const dialogues = {
    anytime: [
        "Feel free to snoop around :)",
        "That computer over there? Full of projects.",
        "Psst... the bookshelf has all the good stuff."
    ],
    nighttime: [
        "Late night coding? Me too!"
    ]
};

let lastDialogue = "";

function getRandomDialogue() {
    const hour = new Date().getHours();
    const isNighttime = hour >= 20 || hour < 6; // 8 PM to 6 AM
    
    // Combine available dialogues
    let availableDialogues = [...dialogues.anytime];
    if (isNighttime) {
        availableDialogues = availableDialogues.concat(dialogues.nighttime);
    }
    
    // Filter out the last shown dialogue to avoid immediate repeats
    if (lastDialogue) {
        availableDialogues = availableDialogues.filter(d => d !== lastDialogue);
    }
    
    // Pick random dialogue
    const randomDialogue = availableDialogues[Math.floor(Math.random() * availableDialogues.length)];
    lastDialogue = randomDialogue;
    
    return randomDialogue;
}

// Avatar click event listener for dialogue box
mainPageAvatar.addEventListener('click', () => {
    playSound(clickSound, 0.3);
    if (dialogueBox.style.display === 'none' || dialogueBox.style.display === '') {
        dialogueText.textContent = getRandomDialogue();
        dialogueBox.style.display = 'block';
    } else {
        dialogueBox.style.display = 'none';
    }
});

// Hide dialogue box when clicking elsewhere
document.addEventListener('click', (event) => {
    if (dialogueBox.style.display === 'block' && 
        !mainPageAvatar.contains(event.target) && 
        !dialogueBox.contains(event.target)) {
        dialogueBox.style.display = 'none';
    }
});

// ===== CLOUD HOPPER GAME LOGIC =====

let cloudGameState = {
    score: 0,
    isPlaying: false,
    clouds: [],
    avatar: null,
    gameArea: null,
    scoreDisplay: null,
    gameLoopInterval: null,
    avatarX: 35, // percentage
    avatarY: 300, // pixels from top (world coordinates)
    avatarVelocityX: 0,
    avatarVelocityY: 0,
    gravity: 0.1,           // MODIFIED: Tuned for precise jump height.
    jumpPower: -4,          // MODIFIED: Tuned for precise jump height.
    moveSpeed: 0.15,        // MODIFIED: Reduced for better control
    isOnCloud: false,
    canJump: false,         // ADDED: Flag to ensure reliable jumping.
    currentCloud: null,
    jumpedClouds: new Set(),
    keys: {},
    cameraY: 0,
    nextCloudY: 230,        // Y position for the next cloud layer.
    cloudSpawnInterval: 80, // Vertical spacing between cloud layers.
    lastCloudX: 35          // ADDED: Tracks the last cloud's X position to ensure a solvable path.
};

const cloudImages = ['cloud1.svg', 'cloud2.svg', 'cloud3.svg', 'cloud4.svg'];
const avatarJumpImages = ['avatar-jump.svg', 'avatar-jump-2.svg'];

function initCloudGame() {
    const gameArea = document.getElementById('cloud-game-area');
    const scoreDisplay = document.getElementById('cloud-score');
    const restartBtn = document.getElementById('restart-game');
    
    if (!gameArea || !scoreDisplay) return;
    
    const gameAreaRect = gameArea.getBoundingClientRect();
    
    // Reset state
    cloudGameState.gameArea = gameArea;
    cloudGameState.scoreDisplay = scoreDisplay;
    cloudGameState.isPlaying = true;
    cloudGameState.score = 0;
    cloudGameState.clouds = [];
    cloudGameState.avatarX = 38; // Starting position moved slightly to the right
    cloudGameState.avatarY = 317.5; // Start avatar on the starting platform (cloud at 310 + 20px visual offset = 330, avatar size 25, so 330 - 12.5 = 317.5)
    cloudGameState.avatarVelocityX = 0;
    cloudGameState.avatarVelocityY = 0;
    cloudGameState.isOnCloud = true; // Start on the starting cloud
    cloudGameState.canJump = true; // Allow jumping from the start
    cloudGameState.currentCloud = null;
    cloudGameState.jumpedClouds = new Set();
    cloudGameState.keys = {};
    // Initialize camera to center on avatar at start
    cloudGameState.cameraY = cloudGameState.avatarY - gameAreaRect.height / 2;
    cloudGameState.lastCloudX = 38; // Start path above avatar's initial X position.
    cloudGameState.nextCloudY = 220;
    
    // Create and add avatar to game area
    const avatar = document.createElement('img');
    avatar.className = 'cloud-game-avatar';
    avatar.src = 'assets/svgs/compressed/avatar.svg';
    gameArea.appendChild(avatar);
    cloudGameState.avatar = avatar;
    
    // Start spawning clouds
    spawnInitialClouds();
    cloudGameState.gameLoopInterval = setInterval(gameLoop, 1000 / 60); // 60 FPS
    
    // Add keyboard listeners
    document.addEventListener('keydown', handleKeyDown);
    document.addEventListener('keyup', handleKeyUp);
    
    // Restart button handler
    if (restartBtn) {
        restartBtn.onclick = () => {
            playSound(clickSound, 0.3);
            stopCloudGame();
            initCloudGame();
        };
    }
    
    // Reset score display styling
    scoreDisplay.style.background = 'rgba(255, 255, 255, 0.8)';
    scoreDisplay.style.color = '#333';
    
    updateScore();
    updateVisualPositions();
}

function stopCloudGame() {
    cloudGameState.isPlaying = false;
    if (cloudGameState.gameLoopInterval) clearInterval(cloudGameState.gameLoopInterval);
    
    document.removeEventListener('keydown', handleKeyDown);
    document.removeEventListener('keyup', handleKeyUp);
    
    // Clear game elements from the DOM (but keep the score display)
    if (cloudGameState.gameArea) {
        // Remove clouds
        cloudGameState.clouds.forEach(cloud => {
            if (cloud.element && cloud.element.parentNode) {
                cloud.element.remove();
            }
        });
        
        // Remove avatar
        if (cloudGameState.avatar && cloudGameState.avatar.parentNode) {
            cloudGameState.avatar.remove();
        }
    }
    
    cloudGameState.clouds = [];
    cloudGameState.avatar = null;
}

function spawnInitialClouds() {
    // Spawn the starting platform directly under the avatar
    const startCloud = createCloudAtPosition(38, 310, 0);
    cloudGameState.gameArea.appendChild(startCloud.element);
    cloudGameState.clouds.push(startCloud);
    
    // Mark the starting cloud as already jumped so it doesn't count toward score
    cloudGameState.jumpedClouds.add(startCloud.id);
    cloudGameState.currentCloud = startCloud.id;
    
    // Spawn the first few layers of clouds to create a path upwards
    for (let i = 0; i < 8; i++) {
        spawnCloudLayer();
    }
}

// REWRITTEN: This function now guarantees a solvable path.
function spawnCloudLayer() {
    if (!cloudGameState.isPlaying) return;
    
    const gameAreaRect = cloudGameState.gameArea.getBoundingClientRect();
    if (!gameAreaRect.width) return;
    
    // Define the maximum horizontal distance a player can comfortably jump.
    const maxHorizontalReach = 45; // in percentage
    const cloudWidthPercent = (80 / gameAreaRect.width) * 100;

    // Calculate the safe spawn range for the next cloud
    const minX = Math.max(5, cloudGameState.lastCloudX - maxHorizontalReach);
    const maxX = Math.min(100 - cloudWidthPercent - 5, cloudGameState.lastCloudX + maxHorizontalReach);

    // Generate a new X position within the safe range
    const newX = minX + Math.random() * (maxX - minX);

    // Create the new cloud
    const speed = (Math.random() * 0.2 + 0.1) * (Math.random() < 0.5 ? 1 : -1);
    const cloud = createCloudAtPosition(newX, cloudGameState.nextCloudY, speed);
    cloudGameState.gameArea.appendChild(cloud.element);
    cloudGameState.clouds.push(cloud);

    // Update state for the next cloud layer
    cloudGameState.lastCloudX = newX;
    cloudGameState.nextCloudY -= cloudGameState.cloudSpawnInterval;
}

function createCloudAtPosition(xPercent, yPixels, speed) {
    const cloud = document.createElement('img');
    cloud.className = 'cloud';
    const randomImage = cloudImages[Math.floor(Math.random() * cloudImages.length)];
    cloud.src = `assets/svgs/compressed/${randomImage}`;
    
    return {
        element: cloud,
        xPercent: xPercent,
        y: yPixels,
        speed: speed,
        width: 80,
        height: 50,
        id: Math.random().toString(36).substr(2, 9)
    };
}

// MODIFIED: Jump logic is now more reliable.
function handleKeyDown(e) {
    if (!cloudGameState.isPlaying) return;
    
    const key = e.key.toLowerCase();
    cloudGameState.keys[key] = true;
    
    // Jump with Up Arrow or W if the player is allowed to jump
    if ((key === 'arrowup' || key === 'w') && cloudGameState.canJump) {
        cloudGameState.avatarVelocityY = cloudGameState.jumpPower;
        cloudGameState.isOnCloud = false;
        cloudGameState.canJump = false; // Prevent double-jumping
        cloudGameState.currentCloud = null;
        playSound(clickSound, 0.3);
        
        if (cloudGameState.avatar) {
            const jumpImage = avatarJumpImages[Math.floor(Math.random() * avatarJumpImages.length)];
            cloudGameState.avatar.src = `assets/svgs/compressed/${jumpImage}`;
            // Add special class for avatar-jump-2 to make it slightly bigger
            if (jumpImage === 'avatar-jump-2.svg') {
                cloudGameState.avatar.classList.add('avatar-jump-2');
            } else {
                cloudGameState.avatar.classList.remove('avatar-jump-2');
            }
        }
    }
    
    // Prevent default browser action for arrow keys and space
    if (['arrowup', 'arrowdown', 'arrowleft', 'arrowright', ' '].includes(key)) {
        e.preventDefault();
    }
}

function handleKeyUp(e) {
    const key = e.key.toLowerCase();
    cloudGameState.keys[key] = false;
}

function gameLoop() {
    if (!cloudGameState.isPlaying) return;
    
    const gameAreaRect = cloudGameState.gameArea.getBoundingClientRect();
    if (!gameAreaRect.width) return;

    // Handle horizontal movement
    if (cloudGameState.keys['arrowleft'] || cloudGameState.keys['a']) {
        cloudGameState.avatarVelocityX -= cloudGameState.moveSpeed;
    } else if (cloudGameState.keys['arrowright'] || cloudGameState.keys['d']) {
        cloudGameState.avatarVelocityX += cloudGameState.moveSpeed;
    } else {
        // Apply stronger friction when on a cloud for better control
        const frictionFactor = cloudGameState.isOnCloud ? 0.75 : 0.85;
        cloudGameState.avatarVelocityX *= frictionFactor;
    }
    
    // Cap horizontal velocity for better control
    const maxVelocityX = 0.8;
    if (cloudGameState.avatarVelocityX > maxVelocityX) {
        cloudGameState.avatarVelocityX = maxVelocityX;
    } else if (cloudGameState.avatarVelocityX < -maxVelocityX) {
        cloudGameState.avatarVelocityX = -maxVelocityX;
    }

    // Apply gravity
    if (!cloudGameState.isOnCloud) {
        cloudGameState.avatarVelocityY += cloudGameState.gravity;
    }
    
    // Update avatar position
    cloudGameState.avatarX += cloudGameState.avatarVelocityX;
    cloudGameState.avatarY += cloudGameState.avatarVelocityY;
    
    // Keep avatar in horizontal bounds
    const avatarWidthPercent = (25 / gameAreaRect.width) * 100;
    if (cloudGameState.avatarX < avatarWidthPercent / 2) {
        cloudGameState.avatarX = avatarWidthPercent / 2;
        cloudGameState.avatarVelocityX = 0;
    }
    if (cloudGameState.avatarX > 100 - (avatarWidthPercent / 2)) {
        cloudGameState.avatarX = 100 - (avatarWidthPercent / 2);
        cloudGameState.avatarVelocityX = 0;
    }
    
    // Update camera to follow the avatar's upward movement
    const targetCameraY = cloudGameState.avatarY - gameAreaRect.height / 1.8;
    if (targetCameraY < cloudGameState.cameraY) {
         cloudGameState.cameraY += (targetCameraY - cloudGameState.cameraY) * 0.1; // Smooth camera follow
    }
    
    // Move clouds first, so avatar moves with its cloud BEFORE collision check
    moveClouds();
    checkCloudCollisions();
    
    // Spawn new clouds as the camera moves up
    if (cloudGameState.nextCloudY > cloudGameState.cameraY - 50) {
        spawnCloudLayer();
    }
    
    // Remove off-screen clouds
    cloudGameState.clouds = cloudGameState.clouds.filter(cloud => {
        if (cloud.y - cloudGameState.cameraY > gameAreaRect.height + 100) {
            cloud.element.remove();
            return false;
        }
        return true;
    });
    
    updateVisualPositions();
    
    // Check for game over
    if (cloudGameState.avatarY - cloudGameState.cameraY > gameAreaRect.height + 50) {
        gameOver();
    }
}

function moveClouds() {
    const gameAreaRect = cloudGameState.gameArea.getBoundingClientRect();
    if (!gameAreaRect.width) return;

    for (const cloud of cloudGameState.clouds) {
        cloud.xPercent += cloud.speed;
        
        if (cloudGameState.isOnCloud && cloudGameState.currentCloud === cloud.id) {
            cloudGameState.avatarX += cloud.speed;
        }
        
        const cloudWidthPercent = (cloud.width / gameAreaRect.width) * 100;
        if (cloud.speed < 0 && cloud.xPercent < -cloudWidthPercent) {
            cloud.xPercent = 100;
        } else if (cloud.speed > 0 && cloud.xPercent > 100) {
            cloud.xPercent = -cloudWidthPercent;
        }
    }
}

// MODIFIED: Collision logic now sets the `canJump` flag.
function checkCloudCollisions() {
    const wasOnCloud = cloudGameState.isOnCloud;
    cloudGameState.isOnCloud = false;
    
    const gameAreaRect = cloudGameState.gameArea.getBoundingClientRect();
    if (!gameAreaRect.width) return;
    
    const avatarSize = 25;
    const avatarBottom = cloudGameState.avatarY + avatarSize / 2;
    const avatarTop = cloudGameState.avatarY - avatarSize / 2;
    const avatarPixelX = (cloudGameState.avatarX / 100) * gameAreaRect.width;

    for (const cloud of cloudGameState.clouds) {
        const cloudTop = cloud.y;
        const cloudBottom = cloud.y + cloud.height;
        const cloudPixelX = (cloud.xPercent / 100) * gameAreaRect.width;
        
        // Account for transparent edges of cloud images (about 15px on each side)
        const cloudPadding = 15;
        const cloudVisualLeft = cloudPixelX + cloudPadding;
        const cloudVisualRight = cloudPixelX + cloud.width - cloudPadding;
        const cloudVisualTop = cloudTop + 20; // Top surface of visible cloud

        // Check if avatar is falling downwards and is vertically aligned with the cloud
        if (cloudGameState.avatarVelocityY >= 0 &&
            avatarBottom > cloudVisualTop &&
            avatarTop < cloudBottom) {
            
            // Check for horizontal overlap with visual cloud area
            if (avatarPixelX > cloudVisualLeft && avatarPixelX < cloudVisualRight) {
                
                // Collision detected!
                cloudGameState.isOnCloud = true;
                cloudGameState.currentCloud = cloud.id;
                cloudGameState.avatarY = cloudVisualTop - avatarSize / 2;
                cloudGameState.avatarVelocityY = 0;
                
                // Grant the ability to jump only upon first landing
                if (!wasOnCloud) {
                    cloudGameState.canJump = true; 
                    if (cloudGameState.avatar) {
                        cloudGameState.avatar.src = 'assets/svgs/compressed/avatar.svg';
                        cloudGameState.avatar.classList.remove('avatar-jump-2');
                    }
                }
                
                if (!cloudGameState.jumpedClouds.has(cloud.id)) {
                    cloudGameState.jumpedClouds.add(cloud.id);
                    cloudGameState.score++;
                    updateScore();
                    playSound(chimeSound, 0.4);
                }
                
                break; // Exit loop after finding a cloud to stand on
            }
        }
    }
}

function updateVisualPositions() {
    if (!cloudGameState.avatar) return;
    
    // Update avatar
    const avatarScreenY = cloudGameState.avatarY - cloudGameState.cameraY;
    cloudGameState.avatar.style.left = `${cloudGameState.avatarX}%`;
    cloudGameState.avatar.style.top = `${avatarScreenY}px`;
    cloudGameState.avatar.style.transform = 'translate(-50%, -50%)';
    
    // Update clouds
    for (const cloud of cloudGameState.clouds) {
        const cloudScreenY = cloud.y - cloudGameState.cameraY;
        cloud.element.style.left = `${cloud.xPercent}%`;
        cloud.element.style.top = `${cloudScreenY}px`;
    }
}

function updateScore() {
    if (cloudGameState.scoreDisplay) {
        cloudGameState.scoreDisplay.textContent = `Clouds Jumped: ${cloudGameState.score}`;
    }
}

function gameOver() {
    if (!cloudGameState.isPlaying) return; // Prevent multiple calls
    cloudGameState.isPlaying = false;
    playSound(whooshSound, 0.5);
    
    if (cloudGameState.scoreDisplay) {
        cloudGameState.scoreDisplay.textContent = `Game Over! Score: ${cloudGameState.score}`;
        cloudGameState.scoreDisplay.style.background = 'rgba(244, 67, 54, 0.9)';
        cloudGameState.scoreDisplay.style.color = 'white';
    }
    
    if (cloudGameState.gameLoopInterval) clearInterval(cloudGameState.gameLoopInterval);
}
